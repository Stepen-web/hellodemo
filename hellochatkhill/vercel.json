{   
  "build": {     
    "src": "hellochakhill/package.json",     
    "use": "@vercel/static-build",     
    "config": {       
      "buildCommand": "npm run build"     
    }   
  },   
  "routes": [     
    {       "src": "/(.*)",       
      "dest": "/hellochakhill/$1"     
    }   
  ] 
}
